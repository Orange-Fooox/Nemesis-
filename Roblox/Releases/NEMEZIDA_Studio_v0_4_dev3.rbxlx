-- LocalScript: StarterPlayer/StarterPlayerScripts/NemezidaCamera
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local player=Players.LocalPlayer
local activeCamera: Camera?=nil
local HEIGHT=42
local BACK=34
local LOOK_OFFSET=Vector3.new(0,2,0)

RunService:BindToRenderStep("NemezidaIsometricCamera",Enum.RenderPriority.Camera.Value,function()
 local camera=workspace.CurrentCamera
 if not camera then return end
 if activeCamera~=camera then
  activeCamera=camera
  camera.CameraType=Enum.CameraType.Scriptable
 end

 local character=player.Character
 local root=character and character:FindFirstChild("HumanoidRootPart")
 if not root then return end
 local focus=root.Position+LOOK_OFFSET
 local position=focus+Vector3.new(0,HEIGHT,BACK)
 camera.CFrame=CFrame.lookAt(position,focus)
 camera.FieldOfView=42
end)
]]></ProtectedString><bool name="Disabled">false</bool><string name="Name">NemezidaCamera</string></Properties></Item><Item class="LocalScript" referent="RBX00000000000000000000000000000014"><Properties><ProtectedString name="Source"><![CDATA[--!strict
-- LocalScript: StarterPlayer/StarterPlayerScripts/NemezidaCombat
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local UserInputService=game:GetService("UserInputService")
local CollectionService=game:GetService("CollectionService")
local player=Players.LocalPlayer
local mouse=player:GetMouse()
local remotes=ReplicatedStorage:WaitForChild("NemezidaRemotes")
local attackRemote=remotes:WaitForChild("BasicAttack") :: RemoteEvent
local abilityRemote=remotes:WaitForChild("UseAbility") :: RemoteEvent

local function enemyFromTarget(target: Instance?): Model?
 if not target then return nil end
 local model=if target:IsA("Model") then target else target:FindFirstAncestorOfClass("Model")
 if model and CollectionService:HasTag(model,"NemezidaEnemy") then return model end
 return nil
end

local function attack()
 local enemy=enemyFromTarget(mouse.Target)
 if enemy then attackRemote:FireServer(enemy) end
end
local keyAbilities={
 [Enum.KeyCode.Z]="SealStrike",
 [Enum.KeyCode.X]="ShadowDash",
 [Enum.KeyCode.C]="EarthRend",
 [Enum.KeyCode.V]="AbyssRelease",
 [Enum.KeyCode.B]="Barrier",
}
UserInputService.InputBegan:Connect(function(input,processed)
 if processed then return end
 if input.UserInputType==Enum.UserInputType.MouseButton1 or input.KeyCode==Enum.KeyCode.F then
  attack()
  return
 end
 local ability=keyAbilities[input.KeyCode]
 if ability then
  local enemy=enemyFromTarget(mouse.Target)
  if ability=="Barrier" or ability=="ShadowDash" then
   abilityRemote:FireServer(ability,enemy)
  elseif enemy then
   abilityRemote:FireServer(ability,enemy)
  end
 end
end)
]]></ProtectedString><bool name="Disabled">false</bool><string name="Name">NemezidaCombat</string></Properties></Item><Item class="LocalScript" referent="RBX00000000000000000000000000000015"><Properties><ProtectedString name="Source"><![CDATA[--!strict
-- LocalScript: StarterPlayer/StarterPlayerScripts/NemezidaMovement
local Players=game:GetService("Players")
local UserInputService=game:GetService("UserInputService")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local player=Players.LocalPlayer
local remote=ReplicatedStorage:WaitForChild("NemezidaRemotes"):WaitForChild("SetSprinting") :: RemoteEvent
local requestedSprinting=false

local function setSprint(value: boolean)
 if requestedSprinting==value then return end
 requestedSprinting=value
 remote:FireServer(value)
end

remote.OnClientEvent:Connect(function(serverState)
 if typeof(serverState)~="boolean" then return end
 -- If the server rejects a start request (for example, empty stamina), wait
 -- for the player to release and press Shift again instead of pretending to run.
 if not serverState and requestedSprinting then
  requestedSprinting=false
 end
end)

UserInputService.InputBegan:Connect(function(input,processed)
 if not processed and input.KeyCode==Enum.KeyCode.LeftShift then setSprint(true) end
end)
UserInputService.InputEnded:Connect(function(input)
 if input.KeyCode==Enum.KeyCode.LeftShift then setSprint(false) end
end)

player.CharacterAdded:Connect(function()
 requestedSprinting=false
end)
]]></ProtectedString><bool name="Disabled">false</bool><string name="Name">NemezidaMovement</string></Properties></Item></Item></Item>
