					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- NEMEZIDA | Single entry point for applying damage (server authoritative).
local Remotes = require(script.Parent.Remotes)

local Damage = {}
Damage.OnPlayerKilled = nil -- function(enemyModel, player), assigned by Main

local function flash(model)
	local hl = model:FindFirstChild("HitFlash")
	if hl then
		hl.Enabled = true
		task.delay(0.09, function()
			if hl.Parent then hl.Enabled = false end
		end)
	end
end

function Damage.ToPlayer(player, amount, source)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return false end
	if char:GetAttribute("IFrames") then return false end
	amount = math.max(1, math.floor(amount + 0.5))
	hum:TakeDamage(amount)
	Remotes.Feedback:FireClient(player, "Hurt", amount)
	if hum.Health <= 0 then
		local who = source and source.Parent and source:GetAttribute("FullName") or "Бездна"
		Remotes.Feedback:FireClient(player, "Died", who)
		if Damage.OnPlayerKilled then
			local ok, err = pcall(Damage.OnPlayerKilled, source, player)
			if not ok then warn("[NEMEZIDA] OnPlayerKilled error: " .. tostring(err)) end
		end
	end
	return true
end

function Damage.ToEnemy(model, amount, player, fromPos, knock, stagger)
	local hum = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	if not hum or not root or hum.Health <= 0 then return false end
	amount = math.max(1, math.floor(amount + 0.5))
	if player then model:SetAttribute("LastAttacker", player.UserId) end
	hum:TakeDamage(amount)
	flash(model)
	if not model:GetAttribute("SuperArmor") then
		if stagger and stagger > 0 then
			model:SetAttribute("StaggerUntil", os.clock() + stagger)
		end
		if knock and knock > 0 and fromPos then
			local d = root.Position - fromPos
			d = Vector3.new(d.X, 0, d.Z)
			if d.Magnitude > 0.01 then
				root.AssemblyLinearVelocity = d.Unit * knock + Vector3.new(0, 6, 0)
			end
		end
	end
	if player then
		Remotes.Feedback:FireClient(player, "Hit", root.Position + Vector3.new(0, 4, 0), amount)
	end
	return true
end

return Damage
]]></ProtectedString>
					<string name="ScriptGuid">{E6E5D447-5EEC-4E50-8B2B-D4E2FD513FB3}</string>
