			<Item class="ModuleScript" referent="RBXCA9C482C7EC741B9B9D269D61D384FD9">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- NEMEZIDA | Creates and exposes the RemoteEvents used by client and server.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local folder = ReplicatedStorage:FindFirstChild("NemezidaRemotes") or Instance.new("Folder")
folder.Name = "NemezidaRemotes"
folder.Parent = ReplicatedStorage

local function event(name)
	local e = folder:FindFirstChild(name) or Instance.new("RemoteEvent")
	e.Name = name
	e.Parent = folder
	return e
end

return {
	Combat = event("Combat"),     -- client -> server: Attack / Heavy / Dodge / Sprint / Flask
	Feedback = event("Feedback"), -- server -> client: Hit / Hurt / Announce / LevelUp / Died / Heal / Dash / Shake
}
]]></ProtectedString>
					<string name="ScriptGuid">{56CE96BE-35F9-4685-B391-E56ADABC14FF}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Remotes</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">50960bd04c1381650b19937a000003ef</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX1A44F335464A4CB6B80C350EFC1D8A19">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- NEMEZIDA | Procedural dark-fantasy arena: ruins, torches, runes, embers and lighting.
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local C = Color3.fromRGB
local World = {}

function World.Build()
	local old = workspace:FindFirstChild("NEMEZIDA_WORLD")
	if old then old:Destroy() end
	local world = Instance.new("Folder")
	world.Name = "NEMEZIDA_WORLD"
	world.Parent = workspace

	local rng = Random.new(7)

	local function part(name, size, cf, color, material, parent)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = cf
		p.Anchored = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Color = color
		p.Material = material or Enum.Material.Slate
		p.Parent = parent or world
		return p
	end

	local function pulse(p, to)
		TweenService:Create(p, TweenInfo.new(1.8 + rng:NextNumber() * 0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Transparency = to or 0.5 }):Play()
	end

	local function light(parent, color, brightness, range)
		local l = Instance.new("PointLight")
		l.Color = color
		l.Brightness = brightness
		l.Range = range
		l.Shadows = false
		l.Parent = parent
		return l
	end

	-- ground, road, walls -------------------------------------------------
	part("Ashen Ground", Vector3.new(150, 4, 150), CFrame.new(0, -2, 0), C(38, 43, 48), Enum.Material.Slate)
	local mats = { Enum.Material.Basalt, Enum.Material.Ground, Enum.Material.Slate, Enum.Material.Pebble }
	for i = 1, 26 do
		local p = part("Ground Patch", Vector3.new(rng:NextNumber(8, 20), 0.12, rng:NextNumber(8, 20)),
			CFrame.new(rng:NextNumber(-52, 52), 0.05, rng:NextNumber(-52, 46)) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0),
			C(32 + rng:NextInteger(0, 18), 36 + rng:NextInteger(0, 16), 40 + rng:NextInteger(0, 16)), mats[rng:NextInteger(1, #mats)])
		p.CanCollide = false
	end
	local road = part("Ancient Road", Vector3.new(22, 0.25, 104), CFrame.new(0, 0.14, -4), C(92, 83, 75), Enum.Material.Cobblestone)
	road.CanCollide = false
	for z = 44, -54, -8 do
		local edge = part("Road Edge", Vector3.new(1.4, 0.5, 6), CFrame.new(rng:NextNumber(0, 1) > 0.5 and 11.4 or -11.4, 0.3, z), C(70, 66, 64), Enum.Material.Cobblestone)
		edge.CanCollide = false
	end

	local wall = C(62, 67, 75)
	part("North Wall", Vector3.new(112, 14, 5), CFrame.new(0, 7, -58), wall)
	part("West Wall", Vector3.new(5, 14, 112), CFrame.new(-58, 7, -4), wall)
	part("East Wall", Vector3.new(5, 14, 112), CFrame.new(58, 7, -4), wall)
	part("South Wall Left", Vector3.new(42, 12, 5), CFrame.new(-37, 6, 50), wall)
	part("South Wall Right", Vector3.new(42, 12, 5), CFrame.new(37, 6, 50), wall)
	for x = -50, 50, 10 do
		part("Wall Crenel", Vector3.new(4, 3, 6), CFrame.new(x, 15.5, -58), C(82, 87, 94))
	end
	-- Invisible barriers so the player cannot walk off the map through the south gate.
	local b = part("South Barrier", Vector3.new(34, 20, 2), CFrame.new(0, 10, 52), C(0, 0, 0), Enum.Material.SmoothPlastic)
	b.Transparency = 1

	-- spawn --------------------------------------------------------------
	local spawn = workspace:FindFirstChildOfClass("SpawnLocation") or Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(8, 1, 8)
	spawn.CFrame = CFrame.new(0, 0.5, 42)
	spawn.Transparency = 1
	spawn.Parent = workspace
	local altar = part("Spawn Altar", Vector3.new(0.3, 12, 12), CFrame.new(0, 0.2, 42) * CFrame.Angles(0, 0, math.rad(90)), C(60, 190, 220), Enum.Material.Neon)
	altar.Shape = Enum.PartType.Cylinder
	altar.CanCollide = false
	altar.Transparency = 0.6
	pulse(altar, 0.85)

	-- ruins ----------------------------------------------------------------
	local rubble = { Vector3.new(-34, 1, 20), Vector3.new(-29, 1, 24), Vector3.new(39, 1, 12), Vector3.new(43, 1, 16), Vector3.new(-43, 1, -28), Vector3.new(33, 1, -35), Vector3.new(25, 1, 35), Vector3.new(-22, 1, -42) }
	for i, pos in ipairs(rubble) do
		part("Rubble " .. i, Vector3.new(5 + i % 3, 2 + i % 2, 4 + i % 2), CFrame.new(pos) * CFrame.Angles(0, i * 0.47, 0), C(75, 78, 83), Enum.Material.Rock)
	end
	for i = 1, 45 do
		local x, z = rng:NextNumber(-54, 54), rng:NextNumber(-54, 48)
		if math.abs(x) > 12 or math.abs(z) > 3 then
			local s = rng:NextNumber(0.8, 2.2)
			part("Stone", Vector3.new(s * 1.4, s, s * 1.1), CFrame.new(x, s / 2 - 0.1, z) * CFrame.Angles(rng:NextNumber(-0.2, 0.2), rng:NextNumber(0, 6.28), rng:NextNumber(-0.2, 0.2)), C(70, 74, 80), Enum.Material.Rock)
		end
	end
	for i = 1, 6 do
		local x = ({ -40, 41, -36, 38, -20, 22 })[i]
		local z = ({ -8, -16, -40, 28, -30, 30 })[i]
		local h = rng:NextNumber(5, 11)
		local col = part("Broken Column", Vector3.new(h, 3.4, 3.4), CFrame.new(x, 1.7, z) * CFrame.Angles(0, rng:NextNumber(0, 6.28), math.rad(90)), C(86, 88, 94), Enum.Material.Marble)
		col.Shape = Enum.PartType.Cylinder
		col.CFrame = CFrame.new(x, h / 2 - 0.5, z) * CFrame.Angles(0, 0, math.rad(90)) * CFrame.Angles(math.rad(rng:NextNumber(-8, 8)), 0, 0)
		col.Size = Vector3.new(h, 3.4, 3.4)
	end
	for i = 1, 10 do
		local x, z = rng:NextNumber(-50, 50), rng:NextNumber(-50, 40)
		part("Bones", Vector3.new(2.2, 0.4, 0.5), CFrame.new(x, 0.3, z) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0.2), C(205, 198, 170), Enum.Material.Marble).CanCollide = false
		part("Skull", Vector3.new(1, 0.9, 1.1), CFrame.new(x + 1, 0.5, z + 0.8), C(215, 208, 180), Enum.Material.Marble).CanCollide = false
	end

	local function deadTree(x, z, scale)
		local m = Instance.new("Model")
		m.Name = "Dead Tree"
		m.Parent = world
		local h = 12 * scale
		local bark = C(55, 43, 39)
		part("Trunk", Vector3.new(2 * scale, h, 2 * scale), CFrame.new(x, h / 2, z), bark, Enum.Material.Wood, m)
		part("Branch", Vector3.new(1.4 * scale, 7 * scale, 1.4 * scale), CFrame.new(x - 2 * scale, h * 0.72, z) * CFrame.Angles(0, 0, math.rad(42)), bark, Enum.Material.Wood, m)
		part("Branch", Vector3.new(1.3 * scale, 6 * scale, 1.3 * scale), CFrame.new(x + 2 * scale, h * 0.82, z) * CFrame.Angles(0, 0, math.rad(-48)), bark, Enum.Material.Wood, m)
		part("Branch", Vector3.new(1 * scale, 5 * scale, 1 * scale), CFrame.new(x, h * 0.95, z + 1.5 * scale) * CFrame.Angles(math.rad(40), 0, 0), bark, Enum.Material.Wood, m)
	end
	deadTree(-44, -42, 1.2)
	deadTree(44, -43, 1)
	deadTree(-45, 35, 0.9)
	deadTree(45, 38, 1.1)
	deadTree(-50, -10, 1.0)
	deadTree(50, 10, 1.15)

	-- torches along the road ---------------------------------------------------
	local function torch(x, z)
		local m = Instance.new("Model")
		m.Name = "Torch"
		m.Parent = world
		part("Post", Vector3.new(1.2, 6, 1.2), CFrame.new(x, 3, z), C(50, 44, 42), Enum.Material.Slate, m)
		local bowl = part("Brazier", Vector3.new(2.6, 0.8, 2.6), CFrame.new(x, 6.4, z), C(35, 32, 32), Enum.Material.Metal, m)
		local fire = Instance.new("Fire")
		fire.Heat = 9
		fire.Size = 6
		fire.Color = C(255, 150, 60)
		fire.SecondaryColor = C(255, 70, 20)
		fire.Parent = bowl
		light(bowl, C(255, 150, 70), 2.6, 26)
	end
	for z = 36, -30, -22 do
		torch(-14, z)
		torch(14, z)
	end

	-- Soul Gate and seal ring (boss arena) -------------------------------------
	local shrine = Instance.new("Model")
	shrine.Name = "Soul Gate"
	shrine.Parent = world
	local stone = C(65, 74, 91)
	part("Obelisk", Vector3.new(5, 18, 5), CFrame.new(0, 9, -46), C(48, 54, 68), Enum.Material.Slate, shrine)
	part("Gate Left", Vector3.new(3, 16, 3), CFrame.new(-8, 8, -46), stone, Enum.Material.Slate, shrine)
	part("Gate Right", Vector3.new(3, 16, 3), CFrame.new(8, 8, -46), stone, Enum.Material.Slate, shrine)
	part("Gate Top", Vector3.new(19, 3, 3), CFrame.new(0, 16, -46), stone, Enum.Material.Slate, shrine)
	local rune = part("Abyss Rune", Vector3.new(1, 12, 1), CFrame.new(0, 9, -43.6), C(80, 190, 210), Enum.Material.Neon, shrine)
	rune.CanCollide = false
	light(rune, C(75, 190, 220), 2.6, 32)
	pulse(rune, 0.45)

	local ring = part("Seal Circle", Vector3.new(0.3, 40, 40), CFrame.new(0, 0.2, -30) * CFrame.Angles(0, 0, math.rad(90)), C(22, 26, 34), Enum.Material.Basalt)
	ring.Shape = Enum.PartType.Cylinder
	ring.CanCollide = false
	local rim = part("Seal Rim", Vector3.new(0.3, 40.6, 40.6), CFrame.new(0, 0.18, -30) * CFrame.Angles(0, 0, math.rad(90)), C(80, 190, 210), Enum.Material.Neon)
	rim.Shape = Enum.PartType.Cylinder
	rim.CanCollide = false
	rim.Transparency = 0.7
	pulse(rim, 0.3)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		local x, z = math.cos(a) * 20, -30 + math.sin(a) * 20
		local pillar = part("Seal Pillar", Vector3.new(2, 7, 2), CFrame.new(x, 3.5, z), C(48, 54, 68), Enum.Material.Slate)
		local crystal = part("Seal Crystal", Vector3.new(1.2, 2.2, 1.2), CFrame.new(x, 8.2, z) * CFrame.Angles(0.4, i, 0.4), C(80, 190, 210), Enum.Material.Neon)
		crystal.CanCollide = false
		light(crystal, C(80, 190, 210), 1.4, 16)
		pulse(crystal, 0.35)
	end

	-- embers ---------------------------------------------------------------------
	local emberPart = part("Embers", Vector3.new(130, 0.5, 130), CFrame.new(0, 1.5, -4), C(0, 0, 0), Enum.Material.SmoothPlastic)
	emberPart.Transparency = 1
	emberPart.CanCollide = false
	emberPart.CanQuery = false
	local em = Instance.new("ParticleEmitter")
	em.Color = ColorSequence.new(C(255, 150, 70), C(255, 90, 40))
	em.LightEmission = 1
	em.Rate = 22
	em.Lifetime = NumberRange.new(6, 10)
	em.Speed = NumberRange.new(2, 5)
	em.EmissionDirection = Enum.NormalId.Top
	em.Acceleration = Vector3.new(0.6, 0.8, 0.3)
	em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.28), NumberSequenceKeypoint.new(1, 0) })
	em.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.15, 0.2), NumberSequenceKeypoint.new(1, 1) })
	em.Parent = emberPart

	-- lighting -------------------------------------------------------------------
	Lighting.ClockTime = 0.4
	Lighting.Brightness = 1.6
	Lighting.Ambient = C(74, 78, 101)
	Lighting.OutdoorAmbient = C(52, 56, 80)
	Lighting.FogColor = C(24, 29, 42)
	Lighting.FogStart = 90
	Lighting.FogEnd = 240
	Lighting.EnvironmentDiffuseScale = 0.3
	Lighting.EnvironmentSpecularScale = 0.2
	Lighting.GlobalShadows = true

	local function effect(class)
		local e = Lighting:FindFirstChildOfClass(class) or Instance.new(class)
		e.Parent = Lighting
		return e
	end
	local atm = effect("Atmosphere")
	atm.Density = 0.3
	atm.Offset = 0.15
	atm.Color = C(128, 143, 174)
	atm.Decay = C(35, 40, 62)
	atm.Glare = 0.15
	atm.Haze = 1.7
	local bloom = effect("BloomEffect")
	bloom.Intensity = 0.7
	bloom.Size = 28
	bloom.Threshold = 1.0
	local cc = effect("ColorCorrectionEffect")
	cc.Contrast = 0.12
	cc.Saturation = -0.12
	cc.TintColor = C(228, 236, 255)
	local dof = Lighting:FindFirstChildOfClass("DepthOfFieldEffect")
	if dof then dof.Enabled = false end
	local rays = Lighting:FindFirstChildOfClass("SunRaysEffect")
	if rays then rays.Intensity = 0.05 end

	print("[NEMEZIDA] world built")
	return world
end

return World
]]></ProtectedString>
