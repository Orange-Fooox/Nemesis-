					<ProtectedString name="Source"><![CDATA[-- NEMEZIDA | Shared configuration: balance and content live here.
local C = Color3.fromRGB
local Config = {}

Config.Player = {
	BaseHealth = 100,
	HealthPerLevel = 15,
	DamagePerLevel = 0.08,
	MaxStamina = 100,
	StaminaRegen = 26,
	RegenDelay = 0.7,
	SprintDrain = 15,
	WalkSpeed = 13,
	SprintSpeed = 19,
	DodgeCost = 22,
	DodgeCooldown = 0.8,
	DodgeIFrames = 0.4,
	DodgeSpeed = 52,
	Flasks = 3,
	FlaskHeal = 45,
	FlaskCooldown = 1.4,
	RespawnTime = 4,
}

Config.Combat = {
	Combo = {
		{ damage = 20, range = 8.5, dot = 0.35, cooldown = 0.40, knock = 22, stagger = 0.25, stamina = 6 },
		{ damage = 22, range = 8.5, dot = 0.35, cooldown = 0.40, knock = 22, stagger = 0.25, stamina = 6 },
		{ damage = 36, range = 10, dot = 0.2, cooldown = 0.70, knock = 46, stagger = 0.70, stamina = 10 },
	},
	ComboReset = 1.0,
	Heavy = { damage = 60, range = 10.5, dot = 0.1, cooldown = 1.3, knock = 62, stagger = 1.0, stamina = 30 },
}

Config.Enemies = {
	["Goblin Scavenger"] = {
		display = "Гоблин-мародёр", hp = 45, damage = 7, speed = 15, aggro = 32, scale = 0.8,
		attacks = { "melee" }, reach = 4.6, windup = 0.42, recover = 0.5, cooldown = 1.2,
		color = C(83, 105, 66), accent = C(195, 188, 79), xp = 12, souls = 4,
	},
	["Bone Archer"] = {
		display = "Костяной лучник", hp = 38, damage = 9, speed = 10, aggro = 42, scale = 0.92,
		attacks = { "shoot" }, shootRange = 30, keepAway = 14, windup = 0.75, recover = 0.4, cooldown = 2.2,
		projectileSpeed = 62, projectiles = 1, spread = 0,
		color = C(135, 127, 111), accent = C(218, 78, 71), xp = 18, souls = 6,
	},
	["Wandering Shadow"] = {
		display = "Блуждающая тень", hp = 42, damage = 10, speed = 13, aggro = 38, scale = 1.0,
		attacks = { "shoot" }, shootRange = 26, keepAway = 10, windup = 0.8, recover = 0.5, cooldown = 2.6,
		projectileSpeed = 40, projectiles = 3, spread = 0.3, ghost = true,
		color = C(47, 43, 70), accent = C(119, 75, 220), xp = 24, souls = 8,
	},
	["Abyss Wretch"] = {
		display = "Падший страж", hp = 120, damage = 12, speed = 11, aggro = 34, scale = 1.15,
		attacks = { "melee" }, reach = 5.8, windup = 0.6, recover = 0.6, cooldown = 1.5,
		color = C(53, 43, 67), accent = C(75, 220, 235), xp = 32, souls = 10,
	},
	["Devourer"] = {
		display = "Пожиратель", hp = 90, damage = 15, speed = 9, aggro = 32, scale = 1.35,
		attacks = { "slam" }, slamRadius = 10, windup = 0.95, recover = 0.8, cooldown = 2.4,
		color = C(75, 49, 44), accent = C(230, 92, 52), xp = 38, souls = 12,
	},
	["Guardian of Seal"] = {
		display = "Страж Печати", hp = 560, damage = 17, speed = 9, aggro = 38, scale = 1.65,
		attacks = { "melee", "slam", "shoot" }, reach = 8, slamRadius = 12, shootRange = 40,
		windup = 0.7, recover = 0.7, cooldown = 1.6, projectileSpeed = 50, projectiles = 3, spread = 0.25,
		superArmor = true, isBoss = true,
		color = C(48, 54, 68), accent = C(80, 190, 210), xp = 260, souls = 120,
	},
}

-- Spawn slots. Killed enemies respawn in their slot after RespawnDelay.
Config.RespawnDelay = 22
Config.BossRespawnDelay = 90
Config.Spawns = {
	{ kind = "Goblin Scavenger", pos = Vector3.new(-14, 0, 20) },
	{ kind = "Goblin Scavenger", pos = Vector3.new(15, 0, 22) },
	{ kind = "Goblin Scavenger", pos = Vector3.new(-34, 0, 4) },
	{ kind = "Goblin Scavenger", pos = Vector3.new(36, 0, -4) },
	{ kind = "Bone Archer", pos = Vector3.new(12, 0, 6) },
	{ kind = "Bone Archer", pos = Vector3.new(-28, 0, -20) },
	{ kind = "Wandering Shadow", pos = Vector3.new(-16, 0, -12) },
	{ kind = "Wandering Shadow", pos = Vector3.new(32, 0, -22) },
	{ kind = "Abyss Wretch", pos = Vector3.new(-2, 0, 2) },
	{ kind = "Abyss Wretch", pos = Vector3.new(-40, 0, -34) },
	{ kind = "Devourer", pos = Vector3.new(24, 0, -20) },
	{ kind = "Guardian of Seal", pos = Vector3.new(0, 0, -30) },
}

Config.Nemesis = {
	MaxRank = 10,
	Names = { "Грак", "Мортис", "Вэрн", "Скарн", "Ор'Дул", "Хаскар", "Зур", "Некрос", "Балор", "Кхазад", "Иссар", "Торвак", "Мракис", "Ульгар" },
	Titles = { "Неудержимый", "Палач Пепла", "Пожиратель Душ", "Клыкастый", "Предтеча Тьмы", "Сломавший Щиты", "Кровавый", "Ночной Охотник", "Вестник Бездны" },
}

return Config
]]></ProtectedString>
