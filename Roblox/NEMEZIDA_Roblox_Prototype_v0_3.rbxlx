			<Item class="LocalScript" referent="RBXC39C39C195B04BF08E00868CC3D7C29E">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- NEMEZIDA | Fixed isometric camera with smooth follow and hit shake.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local feedback = ReplicatedStorage:WaitForChild("NemezidaRemotes"):WaitForChild("Feedback")

local HEIGHT, DISTANCE, FOV = 36, 32, 34
local shake = 0
local focus = nil

feedback.OnClientEvent:Connect(function(kind, a)
	if kind == "Hurt" then
		shake = math.max(shake, math.clamp((a or 10) / 18, 0.3, 1.6))
	elseif kind == "Shake" then
		shake = math.max(shake, a or 1)
	end
end)

RunService:BindToRenderStep("NemezidaCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = FOV
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local target = root.Position + Vector3.new(0, 2, 0)
	focus = focus and focus:Lerp(target, 1 - math.exp(-12 * dt)) or target
	local jitter = Vector3.zero
	if shake > 0.01 then
		jitter = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * shake * 1.4
		shake = math.max(0, shake - dt * 3)
	end
	local pos = focus + Vector3.new(DISTANCE, HEIGHT, DISTANCE)
	camera.CFrame = CFrame.lookAt(pos + jitter, focus + jitter)
end)
]]></ProtectedString>
