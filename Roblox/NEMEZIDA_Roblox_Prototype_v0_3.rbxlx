			<Item class="ModuleScript" referent="RBXB6BE05B7C9874AE1AF8A314AABE958CB">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- NEMEZIDA | Enemy factory, AI state loop, projectiles, death and respawn slots.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Damage = require(script.Parent.Damage)
local Remotes = require(script.Parent.Remotes)
local Progress = require(script.Parent.Progress)
local Nemesis = require(script.Parent.Nemesis)

local C = Color3.fromRGB
local Enemies = {}
local enemyFolder
local worldParams
local projectiles = {}

------------------------------------------------------------------ build
local function build(kind, def, pos)
	local s = def.scale
	local model = Instance.new("Model")
	model.Name = kind

	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1) * s
	root.Transparency = 1
	root.CFrame = CFrame.new(pos + Vector3.new(0, 3 * s, 0))
	root.Parent = model

	local function body(name, size, offset, color, material)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size * s
		p.CFrame = root.CFrame * CFrame.new(offset * s)
		p.Color = color
		p.Material = material or Enum.Material.Slate
		p.CanCollide = false
		p.Massless = true
		p.Parent = model
		local w = Instance.new("WeldConstraint")
		w.Part0 = root
		w.Part1 = p
		w.Parent = p
		return p
	end

	local dark = C(30, 30, 38)
	local torso = body("Torso", Vector3.new(2.3, 3, 1.3), Vector3.new(0, 0.5, 0), def.color)
	local headColor = kind == "Bone Archer" and C(190, 184, 157) or def.color
	body("Head", Vector3.new(1.7, 1.7, 1.5), Vector3.new(0, 2.65, 0), headColor)
	body("Left Arm", Vector3.new(0.65, 2.5, 0.7), Vector3.new(-1.45, 0.4, 0), def.color)
	body("Right Arm", Vector3.new(0.65, 2.5, 0.7), Vector3.new(1.45, 0.4, 0), def.color)
	body("Left Leg", Vector3.new(0.8, 2, 0.9), Vector3.new(-0.55, -2, 0), dark)
	body("Right Leg", Vector3.new(0.8, 2, 0.9), Vector3.new(0.55, -2, 0), dark)
	local eyes = body("Abyss Eyes", Vector3.new(0.9, 0.24, 0.12), Vector3.new(0, 2.75, -0.78), def.accent, Enum.Material.Neon)
	local glow = Instance.new("PointLight")
	glow.Color = def.accent
	glow.Range = 10 * s
	glow.Brightness = 1.2
	glow.Shadows = false
	glow.Parent = eyes

	if kind == "Goblin Scavenger" then
		body("Club", Vector3.new(0.5, 0.5, 3), Vector3.new(1.6, -0.8, -1.4), C(92, 64, 45), Enum.Material.Wood)
		body("Ear L", Vector3.new(1.2, 0.3, 0.4), Vector3.new(-1.3, 3, 0), def.color)
		body("Ear R", Vector3.new(1.2, 0.3, 0.4), Vector3.new(1.3, 3, 0), def.color)
	elseif kind == "Bone Archer" then
		body("Bow", Vector3.new(0.25, 3.8, 0.25), Vector3.new(-1.9, 0.6, -0.9), C(84, 62, 45), Enum.Material.Wood)
		body("BowString", Vector3.new(0.06, 3.5, 0.06), Vector3.new(-1.9, 0.6, -0.55), def.accent, Enum.Material.Neon)
		body("Ribs", Vector3.new(2.4, 0.3, 1.4), Vector3.new(0, 0.9, 0), C(205, 198, 170))
	elseif kind == "Wandering Shadow" then
		body("Hood", Vector3.new(2.1, 2.1, 1.9), Vector3.new(0, 2.7, 0.1), C(26, 22, 44))
		body("Cloak", Vector3.new(2.8, 3.6, 0.5), Vector3.new(0, 0.2, 0.9), C(26, 22, 44))
	elseif kind == "Abyss Wretch" then
		body("Claw L", Vector3.new(0.5, 1.4, 0.5), Vector3.new(-1.45, -1.4, -0.3), def.accent, Enum.Material.Neon)
		body("Claw R", Vector3.new(0.5, 1.4, 0.5), Vector3.new(1.45, -1.4, -0.3), def.accent, Enum.Material.Neon)
		body("Horn L", Vector3.new(0.35, 1.3, 0.35), Vector3.new(-0.7, 3.8, 0), C(190, 184, 157))
		body("Horn R", Vector3.new(0.35, 1.3, 0.35), Vector3.new(0.7, 3.8, 0), C(190, 184, 157))
	elseif kind == "Devourer" then
		body("Maw", Vector3.new(1.7, 0.55, 0.2), Vector3.new(0, 2.15, -0.8), def.accent, Enum.Material.Neon)
		body("Spike L", Vector3.new(0.4, 1.5, 0.4), Vector3.new(-1.4, 2.4, 0), C(190, 170, 150))
		body("Spike R", Vector3.new(0.4, 1.5, 0.4), Vector3.new(1.4, 2.4, 0), C(190, 170, 150))
		body("Belly", Vector3.new(2.7, 1.8, 1.7), Vector3.new(0, -0.3, -0.1), C(96, 58, 50))
	elseif kind == "Guardian of Seal" then
		local steel = C(65, 74, 91)
		body("Pauldron L", Vector3.new(1.7, 1.1, 1.7), Vector3.new(-1.9, 1.9, 0), steel)
		body("Pauldron R", Vector3.new(1.7, 1.1, 1.7), Vector3.new(1.9, 1.9, 0), steel)
		body("Crown 1", Vector3.new(0.35, 1.6, 0.35), Vector3.new(-0.6, 3.9, 0), steel)
		body("Crown 2", Vector3.new(0.35, 2.1, 0.35), Vector3.new(0, 4.1, 0), steel)
		body("Crown 3", Vector3.new(0.35, 1.6, 0.35), Vector3.new(0.6, 3.9, 0), steel)
		body("Core", Vector3.new(1, 1, 0.2), Vector3.new(0, 1.2, -0.72), def.accent, Enum.Material.Neon)
		body("Greatsword", Vector3.new(0.5, 0.5, 6.5), Vector3.new(1.6, -1, -3.5), C(150, 165, 185), Enum.Material.Metal)
		body("Sword Edge", Vector3.new(0.15, 0.55, 5.5), Vector3.new(1.6, -1, -3.8), def.accent, Enum.Material.Neon)
	end

	if def.ghost then
		for _, d in ipairs(model:GetChildren()) do
			if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and d.Name ~= "Abyss Eyes" then
				d.Transparency = 0.3
			end
		end
	end

	local aura = Instance.new("ParticleEmitter")
	aura.Color = ColorSequence.new(def.accent)
	aura.LightEmission = 0.8
	aura.Rate = 7
	aura.Lifetime = NumberRange.new(0.8, 1.4)
	aura.Speed = NumberRange.new(0.5, 1.5)
	aura.EmissionDirection = Enum.NormalId.Top
	aura.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5 * s), NumberSequenceKeypoint.new(1, 0) })
	aura.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	aura.Parent = torso

	local hum = Instance.new("Humanoid")
	hum.MaxHealth = def.hp
	hum.Health = def.hp
	hum.WalkSpeed = def.speed
	hum.HipHeight = 2 * s
	hum.RequiresNeck = false
	hum.BreakJointsOnDeath = false
	hum.DisplayName = def.display
	hum.NameDisplayDistance = 60
	hum.HealthDisplayDistance = 60
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.DisplayWhenDamaged
	hum.Parent = model

	local hl = Instance.new("Highlight")
	hl.Name = "HitFlash"
	hl.FillColor = C(255, 255, 255)
	hl.FillTransparency = 0.25
	hl.OutlineTransparency = 1
	hl.Enabled = false
	hl.Parent = model

	model:SetAttribute("NemezidaEnemy", true)
	model:SetAttribute("EnemyType", kind)
	model:SetAttribute("Damage", def.damage)
	model:SetAttribute("AttackCooldown", def.cooldown)
	model:SetAttribute("Speed", def.speed)
	model:SetAttribute("Radius", 1.2 * s)
	model:SetAttribute("IsBoss", def.isBoss == true)
	model:SetAttribute("SuperArmor", def.superArmor == true)
	model:SetAttribute("FullName", def.display)

	model.PrimaryPart = root
	return model
end

------------------------------------------------------------------ helpers
local function nearestPlayer(position, maxDistance)
	local chosen, chosenRoot, best
	for _, p in ipairs(Players:GetPlayers()) do
		local c = p.Character
		local h = c and c:FindFirstChildOfClass("Humanoid")
		local r = c and c:FindFirstChild("HumanoidRootPart")
		if h and r and h.Health > 0 then
			local d = (r.Position - position).Magnitude
			if d <= maxDistance and (not best or d < best) then
				chosen, chosenRoot, best = p, r, d
			end
		end
	end
	return chosen, chosenRoot, best
end

local function hasLineOfSight(fromPos, toPos)
	return workspace:Raycast(fromPos, toPos - fromPos, worldParams) == nil
end

local function telegraph(cf, size, color, duration, shape)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Transparency = 0.7
	if shape then p.Shape = shape end
	p.Size = size
	p.CFrame = cf
	p.Parent = workspace
	TweenService:Create(p, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = 0.15 }):Play()
	Debris:AddItem(p, duration + 0.1)
	return p
end

local function shockwave(pos, radius, color)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Shape = Enum.PartType.Cylinder
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Transparency = 0.2
	p.Size = Vector3.new(0.4, 2, 2)
	p.CFrame = CFrame.new(pos.X, 0.3, pos.Z) * CFrame.Angles(0, 0, math.rad(90))
	p.Parent = workspace
	TweenService:Create(p, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.4, radius * 2, radius * 2),
		Transparency = 1,
	}):Play()
	Debris:AddItem(p, 0.5)
end

------------------------------------------------------------------ projectiles
local function fireProjectile(source, origin, dir, speed, dmg, color)
	local part = Instance.new("Part")
	part.Name = "EnemyProjectile"
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.new(1, 1, 1)
	part.Material = Enum.Material.Neon
	part.Color = color
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Position = origin
	part.Parent = workspace
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = 12
	l.Brightness = 2
	l.Shadows = false
	l.Parent = part
	local tr0, tr1 = Instance.new("Attachment"), Instance.new("Attachment")
	tr0.Position = Vector3.new(0, 0.4, 0)
	tr1.Position = Vector3.new(0, -0.4, 0)
	tr0.Parent = part
	tr1.Parent = part
	local trail = Instance.new("Trail")
	trail.Attachment0 = tr0
	trail.Attachment1 = tr1
	trail.Lifetime = 0.25
	trail.LightEmission = 1
	trail.Color = ColorSequence.new(color)
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.Parent = part
	table.insert(projectiles, { part = part, pos = origin, dir = dir, speed = speed, damage = dmg, source = source, life = 3 })
end

local function stepProjectiles(dt)
	for i = #projectiles, 1, -1 do
		local pr = projectiles[i]
		local nextPos = pr.pos + pr.dir * pr.speed * dt
		local remove = false
		if workspace:Raycast(pr.pos, nextPos - pr.pos, worldParams) then remove = true end
		if not remove then
			for _, plr in ipairs(Players:GetPlayers()) do
				local c = plr.Character
				local r = c and c:FindFirstChild("HumanoidRootPart")
				local h = c and c:FindFirstChildOfClass("Humanoid")
				if r and h and h.Health > 0 and (r.Position - nextPos).Magnitude < 2.6 then
					if Damage.ToPlayer(plr, pr.damage, pr.source) then
						remove = true
						break
					end
				end
			end
		end
		pr.life -= dt
		if pr.life <= 0 then remove = true end
		if remove then
			pr.part:Destroy()
			table.remove(projectiles, i)
		else
			pr.pos = nextPos
			pr.part.Position = nextPos
		end
	end
end

------------------------------------------------------------------ attacks
local function engageDistance(def, attack)
	if attack == "melee" then return def.reach end
	if attack == "slam" then return def.slamRadius * 0.8 end
	return def.shootRange
end

local function perform(model, def, hum, root, target, attack)
	local tChar = target.Character
	local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
	if not tRoot then return end
	local dmg = model:GetAttribute("Damage") or def.damage
	local speed = model:GetAttribute("Speed") or def.speed
	local flat = Vector3.new(tRoot.Position.X, root.Position.Y, tRoot.Position.Z)
	hum.WalkSpeed = 0
	if (flat - root.Position).Magnitude > 0.1 then
		root.CFrame = CFrame.lookAt(root.Position, flat)
	end
	local origin = root.Position
	local look = root.CFrame.LookVector
	local ground = Vector3.new(origin.X, 0.2, origin.Z)
	local windup = def.windup * (attack == "slam" and 1.4 or 1)

	local tele
	if attack == "melee" then
		local cf = CFrame.lookAt(ground, ground + look) * CFrame.new(0, 0, -def.reach / 2)
		tele = telegraph(cf, Vector3.new(def.reach * 0.75, 0.2, def.reach), def.accent, windup)
	elseif attack == "slam" then
		tele = telegraph(CFrame.new(ground) * CFrame.Angles(0, 0, math.rad(90)),
			Vector3.new(0.2, def.slamRadius * 2, def.slamRadius * 2), def.accent, windup, Enum.PartType.Cylinder)
	else
		local cf = CFrame.lookAt(ground, Vector3.new(tRoot.Position.X, 0.2, tRoot.Position.Z)) * CFrame.new(0, 0, -6)
		tele = telegraph(cf, Vector3.new(0.8, 0.2, 12), def.accent, windup)
	end

	local t0 = os.clock()
	local interrupted = false
	while os.clock() - t0 < windup do
		task.wait(0.05)
		if hum.Health <= 0 or not model.Parent then
			if tele then tele:Destroy() end
			return
		end
		if os.clock() < (model:GetAttribute("StaggerUntil") or 0) then
			interrupted = true
			break
		end
	end
	if tele then tele:Destroy() end
	if interrupted then
		hum.WalkSpeed = speed
		return
	end

	if attack == "melee" then
		for _, p in ipairs(Players:GetPlayers()) do
			local c = p.Character
			local r = c and c:FindFirstChild("HumanoidRootPart")
			if r then
				local d = Vector3.new(r.Position.X - origin.X, 0, r.Position.Z - origin.Z)
				if d.Magnitude <= def.reach + 1.5 and (d.Magnitude < 2.5 or d.Unit:Dot(look) > 0.25) then
					Damage.ToPlayer(p, dmg, model)
				end
			end
		end
	elseif attack == "slam" then
		shockwave(origin, def.slamRadius, def.accent)
		for _, p in ipairs(Players:GetPlayers()) do
			local c = p.Character
			local r = c and c:FindFirstChild("HumanoidRootPart")
			if r then
				local d = Vector3.new(r.Position.X - origin.X, 0, r.Position.Z - origin.Z).Magnitude
				if d <= def.slamRadius + 1 then
					Damage.ToPlayer(p, dmg, model)
				end
				if d <= def.slamRadius * 2 then
					Remotes.Feedback:FireClient(p, "Shake", 1.2)
				end
			end
		end
	else
		local from = origin + look * 2 * def.scale + Vector3.new(0, 1.2, 0)
		local aimAt = tRoot.Position
		local baseDir = (aimAt - from)
		if baseDir.Magnitude < 0.1 then baseDir = look end
		baseDir = baseDir.Unit
		local n = def.projectiles or 1
		for i = 1, n do
			local offset = (i - (n + 1) / 2) * (def.spread or 0)
			local dir = (CFrame.fromEulerAnglesYXZ(0, offset, 0) * CFrame.lookAt(Vector3.zero, baseDir)).LookVector
			fireProjectile(model, from, dir, def.projectileSpeed, dmg, def.accent)
		end
	end

	local rt = os.clock()
	while os.clock() - rt < def.recover do
		task.wait(0.05)
		if hum.Health <= 0 or not model.Parent then return end
	end
	hum.WalkSpeed = speed
end

------------------------------------------------------------------ AI loop
local function pickAttack(def, dist)
	local attacks = def.attacks
	if #attacks == 1 then return attacks[1] end
	local pool = {}
	for _, a in ipairs(attacks) do
		if a == "shoot" then
			if dist > def.reach * 1.5 then table.insert(pool, a) end
		elseif dist <= engageDistance(def, a) + 1 then
			table.insert(pool, a)
		end
	end
	if #pool == 0 then return nil end
	return pool[math.random(#pool)]
end

local function runAI(model, def)
	local hum = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	if not hum or not root then return end
	local home = root.Position
	local nextAttack = os.clock() + 1
	local shooterOnly = #def.attacks == 1 and def.attacks[1] == "shoot"

	task.spawn(function()
		while model.Parent and hum.Health > 0 do
			task.wait(0.1)
			if os.clock() < (model:GetAttribute("StaggerUntil") or 0) then
				hum:MoveTo(root.Position)
				continue
			end
			local aggro = def.aggro
			local target, tRoot, dist = nearestPlayer(root.Position, aggro)
			if target and tRoot then
				local attack = pickAttack(def, dist)
				local engage = attack and engageDistance(def, attack)
				local canAct = attack and dist <= engage and (attack ~= "shoot" or hasLineOfSight(root.Position, tRoot.Position))
				if canAct then
					if os.clock() >= nextAttack then
						perform(model, def, hum, root, target, attack)
						nextAttack = os.clock() + (model:GetAttribute("AttackCooldown") or def.cooldown)
					elseif shooterOnly and dist < def.keepAway then
						local away = root.Position - tRoot.Position
						away = Vector3.new(away.X, 0, away.Z)
						if away.Magnitude > 0.1 then hum:MoveTo(root.Position + away.Unit * 10) end
					else
						hum:MoveTo(root.Position)
					end
				else
					hum:MoveTo(tRoot.Position)
				end
			else
				if (root.Position - home).Magnitude > 4 then
					hum:MoveTo(home)
				end
				local farAway = not nearestPlayer(root.Position, aggro * 1.6)
				if farAway and hum.Health < hum.MaxHealth then
					hum.Health = math.min(hum.MaxHealth, hum.Health + hum.MaxHealth * 0.01)
				end
			end
		end
	end)
end

------------------------------------------------------------------ death
local function onDeath(model, def)
	local attackerId = model:GetAttribute("LastAttacker")
	local killer = attackerId and Players:GetPlayerByUserId(attackerId) or nil
	local rank = model:GetAttribute("NemesisRank") or 1
	if killer then
		Progress.AddXP(killer, def.xp * (1 + 0.5 * (rank - 1)))
		Progress.AddSouls(killer, def.souls * rank)
	end
	Nemesis.OnEnemyKilled(model, killer)

	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
	for _, name in ipairs({ "NemesisAura", "HitFlash" }) do
		local h = model:FindFirstChild(name)
		if h then h:Destroy() end
	end

	local root = model:FindFirstChild("HumanoidRootPart")
	if root then
		root.Anchored = true
		local cf = root.CFrame
		local target = CFrame.new(0, -def.scale * 2.2, 0) * cf * CFrame.Angles(-math.pi / 2, 0, 0)
		TweenService:Create(root, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = target }):Play()
		local att = Instance.new("Attachment")
		att.Parent = root
		local burst = Instance.new("ParticleEmitter")
		burst.Color = ColorSequence.new(def.accent)
		burst.LightEmission = 1
		burst.Speed = NumberRange.new(8, 18)
		burst.Lifetime = NumberRange.new(0.5, 1)
		burst.SpreadAngle = Vector2.new(180, 180)
		burst.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0) })
		burst.Rate = 0
		burst.Parent = att
		burst:Emit(28)
	end
	task.delay(1, function()
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				TweenService:Create(d, TweenInfo.new(1, Enum.EasingStyle.Linear), { Transparency = 1 }):Play()
			end
		end
	end)
	Debris:AddItem(model, 2.4)
end

------------------------------------------------------------------ public API
function Enemies.Spawn(kind, pos, nemesisEntry)
	local def = Config.Enemies[kind]
	if not def then return nil end
	local model = build(kind, def, pos)
	model.Parent = enemyFolder
	CollectionService:AddTag(model, "NemezidaEnemy")
	pcall(function()
		model.HumanoidRootPart:SetNetworkOwner(nil)
	end)
	if nemesisEntry then Nemesis.Apply(model, nemesisEntry) end
	model:FindFirstChildOfClass("Humanoid").Died:Connect(function()
		onDeath(model, def)
	end)
	runAI(model, def)
	return model
end

local function slotLoop(slot)
	local def = Config.Enemies[slot.kind]
	while true do
		local entry = Nemesis.ClaimFor(slot.kind)
		local model = Enemies.Spawn(slot.kind, slot.pos, entry)
		if not model then return end
		while model:IsDescendantOf(workspace) do
			task.wait(0.5)
		end
		task.wait(def.isBoss and Config.BossRespawnDelay or Config.RespawnDelay)
	end
end

function Enemies.Init(worldFolder)
	enemyFolder = workspace:FindFirstChild("NEMEZIDA_ENEMIES") or Instance.new("Folder")
	enemyFolder.Name = "NEMEZIDA_ENEMIES"
	enemyFolder.Parent = workspace
	worldParams = RaycastParams.new()
	worldParams.FilterType = Enum.RaycastFilterType.Include
	worldParams.FilterDescendantsInstances = { worldFolder }
	RunService.Heartbeat:Connect(stepProjectiles)
end

function Enemies.Start()
	for _, slot in ipairs(Config.Spawns) do
		task.spawn(slotLoop, slot)
	end
end

return Enemies
]]></ProtectedString>
					<string name="ScriptGuid">{39EE884B-4494-4280-BA8F-1295BBCA5E6F}</string>
