					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Nemesis</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">50960bd04c1381650b19937a000003ed</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXC2382C885D4D4C3B9B1FAF04A0BB6EB6">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- NEMEZIDA | Player progression: level, XP, souls, flasks. Saved via DataStore (best effort).
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(script.Parent.Remotes)

local Progress = {}
local data = {}
local store
local warned = false

pcall(function()
	store = DataStoreService:GetDataStore("NemezidaPlayer_v1")
end)

local function xpNeeded(level)
	return math.floor(40 * level ^ 1.35)
end

local function publish(player)
	local d = data[player]
	if not d then return end
	player:SetAttribute("Level", d.Level)
	player:SetAttribute("XP", d.XP)
	player:SetAttribute("XPNeeded", xpNeeded(d.Level))
	player:SetAttribute("Souls", d.Souls)
end

local function maxHealthFor(level)
	return Config.Player.BaseHealth + Config.Player.HealthPerLevel * (level - 1)
end

function Progress.ApplyToCharacter(player, char, fullHeal)
	local d = data[player]
	if not d then return end
	local hum = char:WaitForChild("Humanoid", 10)
	if not hum then return end
	hum.MaxHealth = maxHealthFor(d.Level)
	if fullHeal then hum.Health = hum.MaxHealth end
	hum.WalkSpeed = Config.Player.WalkSpeed
end

function Progress.RefillFlasks(player)
	player:SetAttribute("Flasks", Config.Player.Flasks)
end

function Progress.DamageMultiplier(player)
	local level = player:GetAttribute("Level") or 1
	return 1 + Config.Player.DamagePerLevel * (level - 1)
end

function Progress.AddSouls(player, amount)
	local d = data[player]
	if not d then return end
	d.Souls += amount
	publish(player)
end

function Progress.AddXP(player, amount)
	local d = data[player]
	if not d then return end
	d.XP += math.floor(amount)
	local leveled = false
	while d.XP >= xpNeeded(d.Level) do
		d.XP -= xpNeeded(d.Level)
		d.Level += 1
		leveled = true
	end
	publish(player)
	if leveled then
		if player.Character then Progress.ApplyToCharacter(player, player.Character, true) end
		Progress.RefillFlasks(player)
		Remotes.Feedback:FireClient(player, "LevelUp", d.Level)
	end
end

local function save(player)
	local d = data[player]
	if not d or not store or not d.loaded then return end
	local ok, err = pcall(function()
		store:SetAsync("u" .. player.UserId, { Level = d.Level, XP = d.XP, Souls = d.Souls })
	end)
	if not ok and not warned then
		warned = true
		warn("[NEMEZIDA] DataStore save failed (enable Studio API access): " .. tostring(err))
	end
end

local function onPlayer(player)
	data[player] = { Level = 1, XP = 0, Souls = 0, loaded = false }
	publish(player)
	Progress.RefillFlasks(player)

	player.CharacterAdded:Connect(function(char)
		Progress.ApplyToCharacter(player, char, true)
		Progress.RefillFlasks(player)
	end)
	if player.Character then Progress.ApplyToCharacter(player, player.Character, true) end

	task.spawn(function()
		if not store then data[player].loaded = false return end
		local ok, saved = pcall(function()
			return store:GetAsync("u" .. player.UserId)
		end)
		if not data[player] then return end
		if ok and type(saved) == "table" then
			data[player].Level = saved.Level or 1
			data[player].XP = saved.XP or 0
			data[player].Souls = saved.Souls or 0
			publish(player)
			if player.Character then Progress.ApplyToCharacter(player, player.Character, true) end
		elseif not ok and not warned then
			warned = true
			warn("[NEMEZIDA] DataStore load failed (progress will not be saved): " .. tostring(saved))
		end
		-- saving is allowed only after a successful load, so defaults never overwrite real progress
		data[player].loaded = ok
	end)
end

function Progress.Init()
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in ipairs(Players:GetPlayers()) do onPlayer(p) end
	Players.PlayerRemoving:Connect(function(p)
		save(p)
		data[p] = nil
	end)
	game:BindToClose(function()
		for _, p in ipairs(Players:GetPlayers()) do save(p) end
	end)
	task.spawn(function()
		while true do
			task.wait(60)
			for _, p in ipairs(Players:GetPlayers()) do save(p) end
		end
	end)
end

return Progress
]]></ProtectedString>
