		<Item class="Script" referent="RBXF3792891ECDC4AC69B65297615BFEFCA">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- NEMEZIDA | Server bootstrap. Order matters: remotes -> world -> progress -> nemesis -> combat -> enemies.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Modules = ServerScriptService:WaitForChild("Modules")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

pcall(function()
	game:GetService("StarterPlayer").EnableMouseLockOption = false
end)
Players.RespawnTime = Config.Player.RespawnTime

require(Modules.Remotes)
local World = require(Modules.World)
local Progress = require(Modules.Progress)
local Nemesis = require(Modules.Nemesis)
local Damage = require(Modules.Damage)
local Combat = require(Modules.Combat)
local Enemies = require(Modules.Enemies)

local worldFolder = World.Build()
Progress.Init()
Nemesis.Init()
Damage.OnPlayerKilled = Nemesis.OnPlayerKilled
Combat.Init()
Enemies.Init(worldFolder)
Enemies.Start()

print("[NEMEZIDA] v0.3 server started")
]]></ProtectedString>
