					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Enemies</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">50960bd04c1381650b19937a000003ec</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX7A1B47380C2544E88314CFF554511F16">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- NEMEZIDA | The Nemesis system.
-- An ordinary enemy that kills a player is promoted: it gets a name, a title and a rank,
-- grows stronger every time it wins, and returns in its spawn slot until a player kills it.
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(script.Parent.Remotes)
local Progress = require(script.Parent.Progress)

local Nemesis = {}
local registry = {} -- id -> { id, name, title, kind, rank, kills, claimed }
local nextId = 1
local store
local saveQueued = false
local rng = Random.new()

pcall(function()
	store = DataStoreService:GetDataStore("NemezidaWorld_v1")
end)

local function announce(text, color)
	Remotes.Feedback:FireAllClients("Announce", text, color or Color3.fromRGB(230, 190, 90))
end

local function save()
	if not store or saveQueued then return end
	saveQueued = true
	task.delay(5, function()
		saveQueued = false
		local out = {}
		for _, e in pairs(registry) do
			table.insert(out, { id = e.id, name = e.name, title = e.title, kind = e.kind, rank = e.rank, kills = e.kills })
		end
		pcall(function()
			store:SetAsync("Registry", out)
		end)
	end)
end

function Nemesis.Init()
	if not store then return end
	local ok, saved = pcall(function()
		return store:GetAsync("Registry")
	end)
	if ok and type(saved) == "table" then
		for _, e in ipairs(saved) do
			e.claimed = false
			registry[e.id] = e
			nextId = math.max(nextId, e.id + 1)
		end
	end
end

local function create(kind)
	local names, titles = Config.Nemesis.Names, Config.Nemesis.Titles
	local entry = {
		id = nextId,
		name = names[rng:NextInteger(1, #names)],
		title = titles[rng:NextInteger(1, #titles)],
		kind = kind,
		rank = 1,
		kills = 1,
		claimed = true,
	}
	nextId += 1
	registry[entry.id] = entry
	return entry
end

-- Applies (or refreshes) the nemesis stats and look on a live enemy model.
function Nemesis.Apply(model, entry)
	local def = Config.Enemies[model:GetAttribute("EnemyType")]
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not def or not hum then return end
	local r = entry.rank
	local hp = def.hp * (1.6 + 0.35 * (r - 1))
	hum.MaxHealth = hp
	hum.Health = hp
	local speed = def.speed * (1 + 0.04 * (r - 1))
	hum.WalkSpeed = speed
	model:SetAttribute("Speed", speed)
	model:SetAttribute("Damage", def.damage * (1.25 + 0.12 * (r - 1)))
	model:SetAttribute("AttackCooldown", def.cooldown * math.max(0.6, 1 - 0.05 * (r - 1)))
	model:SetAttribute("NemesisId", entry.id)
	model:SetAttribute("NemesisRank", r)
	local full = ("%s «%s»"):format(entry.name, entry.title)
	model:SetAttribute("FullName", full)
	hum.DisplayName = ("☠ %s [%d]"):format(full, r)

	local aura = model:FindFirstChild("NemesisAura")
	if not aura then
		aura = Instance.new("Highlight")
		aura.Name = "NemesisAura"
		aura.FillTransparency = 1
		aura.OutlineTransparency = 0
		aura.DepthMode = Enum.HighlightDepthMode.Occluded
		aura.Parent = model
	end
	aura.OutlineColor = Color3.fromHSV(math.max(0, 0.11 - math.min(r, 10) * 0.01), 0.9, 1)
end

-- Called by Enemies when a slot is about to spawn: returns an unclaimed nemesis of that kind (or nil).
function Nemesis.ClaimFor(kind)
	for _, e in pairs(registry) do
		if e.kind == kind and not e.claimed then
			e.claimed = true
			return e
		end
	end
	return nil
end

-- Called by Damage when an enemy kills a player.
function Nemesis.OnPlayerKilled(model, player)
	if not model or not model.Parent then return end
	if model:GetAttribute("IsBoss") then return end
	local id = model:GetAttribute("NemesisId")
	local entry = id and registry[id]
	if entry then
		entry.rank = math.min(Config.Nemesis.MaxRank, entry.rank + 1)
		entry.kills += 1
		Nemesis.Apply(model, entry)
		announce(("%s «%s» одержал победу и возвысился до ранга %d!"):format(entry.name, entry.title, entry.rank), Color3.fromRGB(235, 90, 70))
	else
		local kind = model:GetAttribute("EnemyType")
		if not kind then return end
		entry = create(kind)
		Nemesis.Apply(model, entry)
		announce(("Из праха возвысился Немезида: %s «%s»"):format(entry.name, entry.title), Color3.fromRGB(235, 90, 70))
	end
	save()
end

-- Called by Enemies when any enemy dies. `killer` is the Player who dealt the last hit (or nil).
function Nemesis.OnEnemyKilled(model, killer)
	local id = model:GetAttribute("NemesisId")
	local entry = id and registry[id]
	if not entry then return end
	if killer then
		registry[id] = nil
		announce(("%s «%s» повержен!"):format(entry.name, entry.title), Color3.fromRGB(120, 220, 160))
		Progress.AddXP(killer, 60 * entry.rank)
		Progress.AddSouls(killer, 25 * entry.rank)
		Progress.RefillFlasks(killer)
	else
		entry.claimed = false
	end
	save()
end

return Nemesis
]]></ProtectedString>
