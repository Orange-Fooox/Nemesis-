					<ProtectedString name="Source"><![CDATA[-- NEMEZIDA | Player combat: light combo, heavy attack, dodge with i-frames, sprint, flask. Server authoritative.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(script.Parent.Remotes)
local Damage = require(script.Parent.Damage)
local Progress = require(script.Parent.Progress)

local P = Config.Player
local Combat = {}
local states = {}

local function get(player)
	if not states[player] then
		states[player] = { stamina = P.MaxStamina, combo = 0, lastAttack = 0, lastCooldown = 0, lastDodge = 0, lastFlask = 0, lastUse = 0, sprint = false, iToken = 0 }
	end
	return states[player]
end

local function parts(player)
	local c = player.Character
	if not c then return end
	local h = c:FindFirstChildOfClass("Humanoid")
	local r = c:FindFirstChild("HumanoidRootPart")
	if h and r and h.Health > 0 then return c, h, r end
end

local function cleanDir(v, fallback)
	if typeof(v) == "Vector3" and v.X == v.X and v.Y == v.Y and v.Z == v.Z then
		local flat = Vector3.new(v.X, 0, v.Z)
		if flat.Magnitude > 0.1 and flat.Magnitude < 1e4 then return flat.Unit end
	end
	return fallback
end

local function publish(player, s)
	player:SetAttribute("Stamina", math.floor(s.stamina))
	player:SetAttribute("MaxStamina", P.MaxStamina)
end

------------------------------------------------------------------ effects
local function slashFx(root, dir, range, color)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Shape = Enum.PartType.Cylinder
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Transparency = 0.35
	p.Size = Vector3.new(0.2, range * 0.9, range * 0.9)
	local center = root.Position + dir * range * 0.45
	p.CFrame = CFrame.new(center.X, root.Position.Y - 2.4, center.Z) * CFrame.Angles(0, 0, math.rad(90))
	p.Parent = workspace
	TweenService:Create(p, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.2, range * 1.5, range * 1.5),
		Transparency = 1,
	}):Play()
	Debris:AddItem(p, 0.3)
end

local swings = {
	CFrame.Angles(-2.2, 0, -0.5),
	CFrame.Angles(-2.2, 0, 0.9),
	CFrame.Angles(-3.0, 0, 0),
	CFrame.Angles(-3.1, 0, 0.4),
}

local function swingArm(char, index)
	local arm = char:FindFirstChild("RightUpperArm")
	local m = arm and arm:FindFirstChild("RightShoulder")
	if not m then return end
	local base = m:GetAttribute("BaseC0")
	if not base then
		base = m.C0
		m:SetAttribute("BaseC0", base)
	end
	TweenService:Create(m, TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { C0 = base * swings[index] }):Play()
	task.delay(0.1, function()
		if m.Parent then
			TweenService:Create(m, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { C0 = base }):Play()
		end
	end)
end

local function giveSword(char)
	local hand = char:WaitForChild("RightHand", 10)
	if not hand or char:FindFirstChild("Sword") then return end
	local function piece(name, size, offset, color, material)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color
		p.Material = material
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.CFrame = hand.CFrame * offset
		local w = Instance.new("Weld")
		w.Part0 = hand
		w.Part1 = p
		w.C0 = offset
		w.Parent = p
		p.Parent = char
		return p
	end
	local blade = piece("Sword", Vector3.new(0.22, 0.5, 4.6), CFrame.new(0, -0.6, -2.7), Color3.fromRGB(190, 205, 220), Enum.Material.Metal)
	piece("SwordRune", Vector3.new(0.08, 0.3, 3.2), CFrame.new(0, -0.6, -2.9), Color3.fromRGB(80, 200, 230), Enum.Material.Neon)
	piece("SwordGuard", Vector3.new(1.7, 0.35, 0.35), CFrame.new(0, -0.6, -0.5), Color3.fromRGB(90, 80, 70), Enum.Material.Metal)
	local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0, -2.3)
	a1.Position = Vector3.new(0, 0, 0.6)
	a0.Parent = blade
	a1.Parent = blade
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.25
	trail.LightEmission = 1
	trail.Color = ColorSequence.new(Color3.fromRGB(90, 210, 240))
	trail.Transparency = NumberSequence.new(0.15, 1)
	trail.Parent = blade
end

------------------------------------------------------------------ attacks
local function strike(player, root, dir, cfg, color)
	local mult = Progress.DamageMultiplier(player)
	slashFx(root, dir, cfg.range, color)
	for _, m in ipairs(CollectionService:GetTagged("NemezidaEnemy")) do
		local h = m:FindFirstChildOfClass("Humanoid")
		local r = m:FindFirstChild("HumanoidRootPart")
		if h and r and h.Health > 0 and m:IsDescendantOf(workspace) then
			local delta = r.Position - root.Position
			local flat = Vector3.new(delta.X, 0, delta.Z)
			local reach = cfg.range + (m:GetAttribute("Radius") or 1)
			if flat.Magnitude <= reach and (flat.Magnitude < 2.5 or flat.Unit:Dot(dir) >= cfg.dot) then
				Damage.ToEnemy(m, cfg.damage * mult, player, root.Position, cfg.knock, cfg.stagger)
			end
		end
	end
end

local function handle(player, action, a)
	local s = get(player)
	local char, hum, root = parts(player)
	if not char or type(action) ~= "string" then return end
	local now = os.clock()

	if action == "Attack" then
		if now - s.lastAttack < s.lastCooldown then return end
		local step = (now - s.lastAttack <= Config.Combat.ComboReset and s.combo < 3) and s.combo + 1 or 1
		local cfg = Config.Combat.Combo[step]
		if s.stamina < cfg.stamina then return end
		s.stamina -= cfg.stamina
		s.lastUse = now
		s.combo = step == 3 and 0 or step
		s.lastAttack = now
		s.lastCooldown = cfg.cooldown
		local dir = cleanDir(a, root.CFrame.LookVector)
		swingArm(char, step)
		strike(player, root, dir, cfg, step == 3 and Color3.fromRGB(255, 170, 70) or Color3.fromRGB(110, 210, 240))
		publish(player, s)

	elseif action == "Heavy" then
		local cfg = Config.Combat.Heavy
		if now - s.lastAttack < math.max(s.lastCooldown, 0.2) or s.stamina < cfg.stamina then return end
		s.stamina -= cfg.stamina
		s.lastUse = now
		s.combo = 0
		s.lastAttack = now
		s.lastCooldown = cfg.cooldown
		local dir = cleanDir(a, root.CFrame.LookVector)
		swingArm(char, 4)
		strike(player, root, dir, cfg, Color3.fromRGB(255, 120, 60))
		Remotes.Feedback:FireClient(player, "Shake", 0.5)
		publish(player, s)

	elseif action == "Dodge" then
		if now - s.lastDodge < P.DodgeCooldown or s.stamina < P.DodgeCost then return end
		s.lastDodge = now
		s.lastUse = now
		s.stamina -= P.DodgeCost
		local dir = cleanDir(Vector3.new(hum.MoveDirection.X, 0, hum.MoveDirection.Z), cleanDir(a, root.CFrame.LookVector))
		s.iToken += 1
		local token = s.iToken
		char:SetAttribute("IFrames", true)
		task.delay(P.DodgeIFrames, function()
			if s.iToken == token and char.Parent then char:SetAttribute("IFrames", nil) end
		end)
		Remotes.Feedback:FireClient(player, "Dash", dir, P.DodgeSpeed)
		publish(player, s)

	elseif action == "Sprint" then
		s.sprint = a == true

	elseif action == "Flask" then
		if now - s.lastFlask < P.FlaskCooldown then return end
		local flasks = player:GetAttribute("Flasks") or 0
		if flasks <= 0 or hum.Health >= hum.MaxHealth then return end
		s.lastFlask = now
		player:SetAttribute("Flasks", flasks - 1)
		local before = hum.Health
		hum.Health = math.min(hum.MaxHealth, hum.Health + P.FlaskHeal)
		Remotes.Feedback:FireClient(player, "Heal", math.floor(hum.Health - before))
	end
end

------------------------------------------------------------------ init
function Combat.Init()
	Remotes.Combat.OnServerEvent:Connect(handle)

	local function onPlayer(player)
		local s = get(player)
		player.CharacterAdded:Connect(function(char)
			s.stamina = P.MaxStamina
			s.combo = 0
			s.sprint = false
			publish(player, s)
			task.spawn(giveSword, char)
		end)
		if player.Character then task.spawn(giveSword, player.Character) end
		publish(player, s)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in ipairs(Players:GetPlayers()) do onPlayer(p) end
	Players.PlayerRemoving:Connect(function(p) states[p] = nil end)

	task.spawn(function()
		while true do
			task.wait(0.1)
			for _, p in ipairs(Players:GetPlayers()) do
				local s = get(p)
				local _, h = parts(p)
				if h then
					local moving = h.MoveDirection.Magnitude > 0.1
					if s.sprint and moving and s.stamina > 0 then
						s.stamina = math.max(0, s.stamina - P.SprintDrain * 0.1)
						s.lastUse = os.clock()
						h.WalkSpeed = P.SprintSpeed
					else
						if s.stamina <= 0 then s.sprint = false end
						h.WalkSpeed = P.WalkSpeed
						if os.clock() - s.lastUse > P.RegenDelay then
							s.stamina = math.min(P.MaxStamina, s.stamina + P.StaminaRegen * 0.1)
						end
					end
					publish(p, s)
				end
			end
		end
	end)
end

return Combat
]]></ProtectedString>
					<string name="ScriptGuid">{9382C900-EE40-445F-802B-1A6B42105375}</string>
