		</Properties>
		<Item class="LocalScript" referent="RBX9583F89DB4814173A527BC9BED6F2E1F">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- NEMEZIDA | HUD: health, stamina, XP, flasks, boss/nemesis bar, floating numbers, announcements, death screen.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local feedback = ReplicatedStorage:WaitForChild("NemezidaRemotes"):WaitForChild("Feedback")
local C = Color3.fromRGB

local gui = Instance.new("ScreenGui")
gui.Name = "NemezidaHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

local function new(class, props, parent)
	local i = Instance.new(class)
	for k, v in pairs(props) do i[k] = v end
	i.Parent = parent
	return i
end

local function stroke(parent, color, thickness)
	return new("UIStroke", { Color = color or C(90, 80, 60), Thickness = thickness or 1.5, Transparency = 0.2 }, parent)
end

local function bar(parent, y, h, c1, c2)
	local back = new("Frame", { Position = UDim2.fromOffset(14, y), Size = UDim2.new(1, -28, 0, h), BackgroundColor3 = C(20, 20, 26), BorderSizePixel = 0 }, parent)
	new("UICorner", { CornerRadius = UDim.new(0, 4) }, back)
	stroke(back, C(70, 62, 48), 1)
	local fill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = c1, BorderSizePixel = 0 }, back)
	new("UICorner", { CornerRadius = UDim.new(0, 4) }, fill)
	new("UIGradient", { Color = ColorSequence.new(c1, c2), Rotation = 90 }, fill)
	return fill, back
end

-- status panel --------------------------------------------------------------
local panel = new("Frame", {
	AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 24, 1, -24), Size = UDim2.fromOffset(360, 128),
	BackgroundColor3 = C(12, 13, 18), BackgroundTransparency = 0.15, BorderSizePixel = 0,
}, gui)
new("UICorner", { CornerRadius = UDim.new(0, 8) }, panel)
stroke(panel, C(110, 92, 58), 2)

local levelLabel = new("TextLabel", {
	BackgroundTransparency = 1, Position = UDim2.fromOffset(14, 8), Size = UDim2.fromOffset(120, 22),
	Font = Enum.Font.GothamBold, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C(235, 205, 130), Text = "УР. 1",
}, panel)
local soulsLabel = new("TextLabel", {
	BackgroundTransparency = 1, Position = UDim2.new(1, -174, 0, 8), Size = UDim2.fromOffset(160, 22),
	Font = Enum.Font.GothamSemibold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = C(130, 210, 230), Text = "Души: 0",
}, panel)
local healthFill, healthBack = bar(panel, 36, 22, C(190, 52, 60), C(120, 28, 36))
local healthText = new("TextLabel", {
	BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = C(255, 240, 240), Text = "",
}, healthBack)
local staminaFill = bar(panel, 64, 12, C(222, 180, 70), C(150, 110, 38))
local xpFill = bar(panel, 84, 6, C(110, 190, 235), C(60, 110, 170))
local flaskLabel = new("TextLabel", {
	BackgroundTransparency = 1, Position = UDim2.fromOffset(14, 96), Size = UDim2.new(1, -28, 0, 24),
	Font = Enum.Font.GothamSemibold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C(120, 220, 140), Text = "",
}, panel)

-- boss / nemesis bar ------------------------------------------------------------
local bossFrame = new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 28), Size = UDim2.fromOffset(560, 46),
	BackgroundTransparency = 1, Visible = false,
}, gui)
local bossName = new("TextLabel", {
	BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 22), Font = Enum.Font.GothamBold, TextSize = 18,
	TextColor3 = C(240, 220, 170), TextStrokeTransparency = 0.4, Text = "",
}, bossFrame)
local bossBack = new("Frame", { Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 14), BackgroundColor3 = C(18, 18, 22), BorderSizePixel = 0 }, bossFrame)
new("UICorner", { CornerRadius = UDim.new(0, 4) }, bossBack)
stroke(bossBack, C(150, 120, 70), 1.5)
local bossFill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(170, 40, 48), BorderSizePixel = 0 }, bossBack)
new("UICorner", { CornerRadius = UDim.new(0, 4) }, bossFill)
new("UIGradient", { Color = ColorSequence.new(C(220, 70, 70), C(120, 24, 34)), Rotation = 90 }, bossFill)

-- announcements -----------------------------------------------------------------
local announce = new("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.16, 0), Size = UDim2.fromOffset(900, 50),
	BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 28, TextTransparency = 1,
	TextStrokeTransparency = 1, TextColor3 = C(255, 255, 255), Text = "",
}, gui)
local announceToken = 0
local function say(text, color, size)
	announceToken += 1
	local token = announceToken
	announce.Text = text
	announce.TextSize = size or 28
	announce.TextColor3 = color or C(235, 205, 130)
	announce.TextTransparency = 0
	announce.TextStrokeTransparency = 0.3
	task.delay(3.2, function()
		if token ~= announceToken then return end
		TweenService:Create(announce, TweenInfo.new(0.8), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	end)
end

-- hurt vignette + death screen -----------------------------------------------------
local hurt = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(170, 10, 20), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 0 }, gui)
local death = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(0, 0, 0), BackgroundTransparency = 1, Visible = false, ZIndex = 10 }, gui)
local deathTitle = new("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), Size = UDim2.fromOffset(800, 90), BackgroundTransparency = 1,
	Font = Enum.Font.GothamBlack, TextSize = 72, TextColor3 = C(190, 40, 46), Text = "ТЫ ПАЛ", ZIndex = 11,
}, death)
local deathSub = new("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.54), Size = UDim2.fromOffset(900, 40), BackgroundTransparency = 1,
	Font = Enum.Font.GothamSemibold, TextSize = 22, TextColor3 = C(220, 210, 190), Text = "", ZIndex = 11,
}, death)

-- controls hint ----------------------------------------------------------------------
new("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Size = UDim2.fromOffset(900, 20), BackgroundTransparency = 1,
	Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = C(170, 168, 160), TextTransparency = 0.25,
	Text = "WASD — движение   ЛКМ/F — удар (серия)   ПКМ/E — тяжёлый удар   Space — уклонение   Shift — бег   Q — фляга",
}, gui)

-- floating numbers -----------------------------------------------------------------------
local function floatText(pos, text, color, size)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.one * 0.2
	p.Position = pos + Vector3.new((math.random() - 0.5) * 2, 0, (math.random() - 0.5) * 2)
	p.Parent = workspace
	local bb = new("BillboardGui", { Size = UDim2.fromOffset(140, 44), AlwaysOnTop = true, Adornee = p }, p)
	local tl = new("TextLabel", {
		BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Font = Enum.Font.GothamBlack, TextSize = size or 24,
		TextColor3 = color, TextStrokeTransparency = 0.2, Text = text,
	}, bb)
	TweenService:Create(p, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = p.Position + Vector3.new(0, 4.5, 0) }):Play()
	TweenService:Create(tl, TweenInfo.new(0.9, Enum.EasingStyle.Linear), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(p, 1)
end

feedback.OnClientEvent:Connect(function(kind, a, b)
	if kind == "Hit" then
		local big = (b or 0) >= 40
		floatText(a, tostring(b), big and C(255, 170, 70) or C(255, 245, 225), big and 32 or 24)
	elseif kind == "Hurt" then
		hurt.BackgroundTransparency = 0.72
		TweenService:Create(hurt, TweenInfo.new(0.45), { BackgroundTransparency = 1 }):Play()
	elseif kind == "Heal" then
		local c = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if c then floatText(c.Position + Vector3.new(0, 4, 0), "+" .. tostring(a), C(120, 235, 150), 28) end
	elseif kind == "Announce" then
		say(a, b, 26)
	elseif kind == "LevelUp" then
		say("УРОВЕНЬ " .. tostring(a), C(120, 210, 255), 36)
	elseif kind == "Died" then
		death.Visible = true
		death.BackgroundTransparency = 1
		deathTitle.TextTransparency = 1
		deathSub.TextTransparency = 1
		deathSub.Text = "Тебя сразил: " .. tostring(a)
		TweenService:Create(death, TweenInfo.new(0.8), { BackgroundTransparency = 0.45 }):Play()
		TweenService:Create(deathTitle, TweenInfo.new(0.8), { TextTransparency = 0 }):Play()
		TweenService:Create(deathSub, TweenInfo.new(0.8), { TextTransparency = 0 }):Play()
	end
end)

player.CharacterAdded:Connect(function()
	if death.Visible then
		TweenService:Create(death, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
		TweenService:Create(deathTitle, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
		TweenService:Create(deathSub, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
		task.delay(0.55, function() death.Visible = false end)
	end
end)

-- per-frame updates -------------------------------------------------------------------------
local shownHealth, shownStamina, shownXp = 1, 1, 0

local function getHumanoid()
	local c = player.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end

local nextBossScan = 0
local bossTarget = nil

RunService.RenderStepped:Connect(function(dt)
	local k = 1 - math.exp(-12 * dt)
	local hum = getHumanoid()
	if hum then
		local ratio = math.clamp(hum.Health / math.max(1, hum.MaxHealth), 0, 1)
		shownHealth += (ratio - shownHealth) * k
		healthFill.Size = UDim2.fromScale(shownHealth, 1)
		healthText.Text = ("%d / %d"):format(math.ceil(hum.Health), math.ceil(hum.MaxHealth))
	end
	local st = (player:GetAttribute("Stamina") or 100) / math.max(1, player:GetAttribute("MaxStamina") or 100)
	shownStamina += (st - shownStamina) * k
	staminaFill.Size = UDim2.fromScale(math.clamp(shownStamina, 0, 1), 1)
	local xp = (player:GetAttribute("XP") or 0) / math.max(1, player:GetAttribute("XPNeeded") or 1)
	shownXp += (xp - shownXp) * k
	xpFill.Size = UDim2.fromScale(math.clamp(shownXp, 0, 1), 1)
	levelLabel.Text = "УР. " .. tostring(player:GetAttribute("Level") or 1)
	soulsLabel.Text = "Души: " .. tostring(player:GetAttribute("Souls") or 0)
	flaskLabel.Text = "Фляги: " .. string.rep("● ", player:GetAttribute("Flasks") or 0)

	-- boss / nemesis bar
	if os.clock() > nextBossScan then
		nextBossScan = os.clock() + 0.2
		bossTarget = nil
		local c = player.Character
		local root = c and c:FindFirstChild("HumanoidRootPart")
		if root then
			local best
			for _, m in ipairs(CollectionService:GetTagged("NemezidaEnemy")) do
				if m:GetAttribute("IsBoss") or m:GetAttribute("NemesisId") then
					local h = m:FindFirstChildOfClass("Humanoid")
					local r = m:FindFirstChild("HumanoidRootPart")
					if h and r and h.Health > 0 then
						local d = (r.Position - root.Position).Magnitude
						if d < 60 and (not best or d < best) then
							best = d
							bossTarget = h
						end
					end
				end
			end
		end
	end
	if bossTarget and bossTarget.Parent and bossTarget.Health > 0 then
		bossFrame.Visible = true
		bossName.Text = bossTarget.DisplayName
		bossFill.Size = UDim2.fromScale(math.clamp(bossTarget.Health / math.max(1, bossTarget.MaxHealth), 0, 1), 1)
	else
		bossFrame.Visible = false
	end
end)
]]></ProtectedString>
