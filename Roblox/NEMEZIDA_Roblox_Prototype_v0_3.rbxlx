			<Item class="LocalScript" referent="RBXFED798D66345413AADD66CC9B0A0C50E">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- NEMEZIDA | Input: mouse aiming on the ground plane, attacks, dodge, sprint, flask.
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local remotes = ReplicatedStorage:WaitForChild("NemezidaRemotes")
local combat = remotes:WaitForChild("Combat")
local feedback = remotes:WaitForChild("Feedback")

local holding = false
local lastSend = 0

local function getRoot()
	local c = player.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	local r = c and c:FindFirstChild("HumanoidRootPart")
	if h and r and h.Health > 0 then return r end
end

local function aimDirection(root)
	local loc = UIS:GetMouseLocation()
	local ray = camera:ViewportPointToRay(loc.X, loc.Y)
	if math.abs(ray.Direction.Y) < 1e-4 then return nil end
	local t = (root.Position.Y - ray.Origin.Y) / ray.Direction.Y
	if t <= 0 then return nil end
	local hit = ray.Origin + ray.Direction * t
	local d = Vector3.new(hit.X - root.Position.X, 0, hit.Z - root.Position.Z)
	if d.Magnitude < 0.1 then return nil end
	return d.Unit
end

local function face(root, dir)
	root.CFrame = CFrame.lookAt(root.Position, root.Position + dir)
end

local function act(action)
	local root = getRoot()
	if not root then return end
	local dir = aimDirection(root) or root.CFrame.LookVector
	if action == "Attack" or action == "Heavy" then face(root, dir) end
	combat:FireServer(action, dir)
end

UIS.InputBegan:Connect(function(input, processed)
	if processed then return end
	local t, k = input.UserInputType, input.KeyCode
	if t == Enum.UserInputType.MouseButton1 or k == Enum.KeyCode.F then
		holding = true
		act("Attack")
	elseif t == Enum.UserInputType.MouseButton2 or k == Enum.KeyCode.E then
		act("Heavy")
	elseif k == Enum.KeyCode.Space then
		act("Dodge")
	elseif k == Enum.KeyCode.Q then
		act("Flask")
	elseif k == Enum.KeyCode.LeftShift then
		combat:FireServer("Sprint", true)
	end
end)

UIS.InputEnded:Connect(function(input)
	local t, k = input.UserInputType, input.KeyCode
	if t == Enum.UserInputType.MouseButton1 or k == Enum.KeyCode.F then
		holding = false
	elseif k == Enum.KeyCode.LeftShift then
		combat:FireServer("Sprint", false)
	end
end)

-- hold the attack button to keep chaining the combo
RunService.Heartbeat:Connect(function()
	if holding and os.clock() - lastSend > 0.12 then
		lastSend = os.clock()
		act("Attack")
	end
end)

feedback.OnClientEvent:Connect(function(kind, a, b)
	if kind == "Dash" then
		local root = getRoot()
		if root and typeof(a) == "Vector3" then
			face(root, a)
			root.AssemblyLinearVelocity = Vector3.new(a.X * b, 6, a.Z * b)
		end
	end
end)
]]></ProtectedString>
